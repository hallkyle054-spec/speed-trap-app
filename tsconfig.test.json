{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "data/geo.ts",
    "data/zones.ts",
    "data/routes.ts",
    "data/dates.ts",
    "ingest/parse.mjs",
    "tests/**/*.ts"
  ]
}
